# =============================================================
# Syncro API — variaveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env real.
# =============================================================

# --- Banco ---
DATABASE_URL=postgresql://user:senha@localhost:5432/syncro

# --- Autenticacao (OBRIGATORIO) ---
# Sem JWT_SECRET a API nao sobe. Nao existe mais fallback 'dev_secret':
# com ele, qualquer pessoa conseguiria forjar tokens validos.
JWT_SECRET=
JWT_EXPIRES_IN=15m

# --- Frontend ---
FRONTEND_URL=https://meusyncro.com.br
APP_WEB_URL=https://meusyncro.com.br

# --- Mercado Pago (PIX do salao) ---
# Segredo da assinatura do webhook (painel do MP > Webhooks > Assinatura secreta).
# Sem ele o webhook continua funcionando, mas perde a camada de validacao de origem.
MP_WEBHOOK_SECRET=

# Taxa do PIX usada no calculo de comissao (default 0.0099 = 0,99%)
PIX_FEE_RATE=0.0099

# --- Asaas — cobranca da assinatura do Syncro (plano unico, R$ 97/mes) ---
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_SUBSCRIPTION_VALUE=97.00
# OBRIGATORIO: token do webhook do Asaas (painel > Integracoes > Webhook).
# Sem ele o webhook e rejeitado — antes qualquer POST forjado ativava plano PRO.
ASAAS_WEBHOOK_TOKEN=

# --- WhatsApp (Evolution API) ---
WHATSAPP_API_URL=http://127.0.0.1:8081
# Sem fallback hardcoded. A chave antiga vazou no repositorio: rotacione-a.
WHATSAPP_API_KEY=

# --- E-mail (Resend) ---
# Sem esta chave NENHUM e-mail e entregue (confirmacao, recuperacao de senha).
RESEND_API_KEY=
EMAIL_FROM=Agendamentos <onboarding@resend.dev>

# --- Observabilidade ---
SENTRY_DSN=

# --- Desenvolvimento ---
NODE_ENV=development
# Segredo exigido pela rota /payments/sandbox/simulate-pay (bloqueada em producao)
SANDBOX_SECRET=
