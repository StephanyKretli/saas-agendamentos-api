# =============================================================
# Syncro API — variaveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env real.
# =============================================================

# --- Banco ---
DATABASE_URL=postgresql://user:senha@localhost:5432/syncro

# --- Autenticacao (OBRIGATORIO) ---
# Sem JWT_SECRET a API nao sobe. Nao existe mais fallback 'dev_secret':
# com ele, qualquer pessoa conseguiria forjar tokens validos.
JWT_SECRET=
JWT_EXPIRES_IN=15m

# --- Frontend ---
FRONTEND_URL=https://meusyncro.com.br
# Duplicata de FRONTEND_URL, mantida por compatibilidade — nao adicione nada novo aqui.
APP_WEB_URL=https://meusyncro.com.br
# URL publica DESTA API (base do link de descadastro no rodape dos e-mails).
# Se ausente, cai em https://api.meusyncro.com.br.
API_URL=https://api.meusyncro.com.br

# --- Mercado Pago (PIX do salao) ---
# Segredo da assinatura do webhook (painel do MP > Webhooks > Assinatura secreta).
# Sem ele o webhook continua funcionando, mas perde a camada de validacao de origem.
MP_WEBHOOK_SECRET=

# Taxa do PIX usada no calculo de comissao (default 0.0099 = 0,99%)
PIX_FEE_RATE=0.0099

# --- Asaas — cobranca da assinatura do Syncro (plano unico, R$ 97/mes) ---
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_SUBSCRIPTION_VALUE=97.00
# OBRIGATORIO: token do webhook do Asaas (painel > Integracoes > Webhook).
# Sem ele o webhook e rejeitado — antes qualquer POST forjado ativava plano PRO.
ASAAS_WEBHOOK_TOKEN=

# --- WhatsApp (Evolution API) ---
WHATSAPP_API_URL=http://127.0.0.1:8081
# Sem fallback hardcoded. A chave antiga vazou no repositorio: rotacione-a.
WHATSAPP_API_KEY=
# Instancia do Evolution que envia TODA a regua de trial (boas-vindas + T1-T16 + T4).
# Nome exato da instancia no Evolution (ex.: v2_syncro_sistema). Se ausente, o
# codigo cai num fallback hardcoded — defina sempre em producao.
WHATSAPP_SYSTEM_INSTANCE=

# --- E-mail (Resend) ---
# O envio e 100% Resend (HTTP). Nao ha SMTP: qualquer bloco SMTP_* que exista
# num .env e configuracao MORTA (nenhum arquivo em src le essas variaveis) —
# pode remover.
#
# OBRIGATORIA. Sem ela NENHUM e-mail sai (confirmacao, recuperacao de senha,
# regua de onboarding) — o servico so loga o erro. Confirme no container que
# esta setada; nao assuma pelo .env.example.
RESEND_API_KEY=
# "Nome <endereco>". O dominio do endereco PRECISA estar verificado no Resend,
# senao o Resend recusa o envio (o default abaixo so entrega pro dono da conta).
EMAIL_FROM=Agendamentos <onboarding@resend.dev>
# Reply-To dos e-mails de onboarding — precisa ser uma caixa REAL e monitorada
# (o e-mail 2 pede resposta). Se ausente, usa o endereco do EMAIL_FROM.
EMAIL_REPLY_TO=contato@meusyncro.com.br

# --- Observabilidade ---
SENTRY_DSN=

# --- Desenvolvimento ---
NODE_ENV=development
# Segredo exigido pela rota /payments/sandbox/simulate-pay (bloqueada em producao)
SANDBOX_SECRET=
