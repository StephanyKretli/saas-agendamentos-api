generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums para Gestão de SaaS
enum Plan {
  STARTER
  PRO
  BUSINESS
}

enum Role {
  ADMIN
  PROFESSIONAL
  USER
}

enum AppointmentStatus {
  SCHEDULED
  CANCELED
  COMPLETED
}

// Quem criou o agendamento: a profissional lançando (ela mesma testando o
// próprio link, ou pelo dashboard) vs. uma cliente real marcando sozinha.
// Distinção crítica pra régua de ativação do trial — ver REGUA_RELACIONAMENTO_WHATSAPP.md §8.
enum BookingOrigem {
  PROFISSIONAL
  CLIENTE
}

enum TrialTouchStatus {
  PENDENTE
  ENVIADO
  FALHOU
}

// Estado de processamento de um webhook do Asaas. Mesmo desenho do
// TrialTouchStatus: reservar PENDENTE -> PROCESSADO no sucesso, FALHOU no erro
// (com `erro` e `tentativas`). Sem isto, um pagamento confirmado que falha ao
// processar era descartado no reenvio "porque já tinha linha".
enum WebhookEventStatus {
  PENDENTE
  PROCESSADO
  FALHOU
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  password          String
  username          String    @unique
  avatarUrl         String?
  bio               String?
  phone             String?
  document          String?
  resetToken        String?
  resetTokenExpires DateTime?

  // Configurações de SaaS
  role       Role @default(USER)
  plan       Plan @default(STARTER)
  maxMembers Int  @default(3)

  trialEndsAt         DateTime? // Quando acabam os 14 dias grátis?
  subscriptionStatus  String    @default("TRIAL") // TRIAL, ACTIVE, PAST_DUE, CANCELED
  asaasCustomerId     String? // ID do cliente lá no painel do Asaas (cus_xxxx)
  asaasSubscriptionId String? // ID da assinatura lá no Asaas (sub_xxxx)

  // Hierarquia de Equipe
  ownerId     String?
  owner       User?   @relation("TeamHierarchy", fields: [ownerId], references: [id])
  teamMembers User[]  @relation("TeamHierarchy")

  // Preferência de onboarding: dona optou por trabalhar sozinha (sem convidar equipe)
  isSoloProfessional Boolean @default(false)

  // Configurações de Agendamento
  timezone                String @default("America/Sao_Paulo")
  bufferMinutes           Int    @default(0)
  minBookingNoticeMinutes Int    @default(0)
  maxBookingDays          Int    @default(30)

  // 👇 NOVAS REGRAS FINANCEIRAS (Configuradas pelo Admin/Dona do Salão)
  absorbPixFee          Boolean @default(true) // true = Salão absorve a taxa PIX | false = Abate do valor antes da comissão
  defaultCommissionRate Float? // Porcentagem padrão do profissional (ex: 50.0). Usado se o serviço específico não tiver taxa.
  commissionType        String  @default("PERCENTAGE") // "PERCENTAGE" (Porcentagem) ou "FIXED" (Valor Fixo)

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  requirePixDeposit      Boolean  @default(false) // Desligado por padrão
  pixDepositPercentage   Int      @default(20) // 20% por padrão
  mercadoPagoAccessToken String?
  centralizePayments     Boolean  @default(true) // true = Cai pro Dono | false = Cai pro Funcionário

  // Relações de Serviços
  ownedServices Service[] @relation("UserOwnedServices")

  // 👇 RELAÇÃO ATUALIZADA: Agora aponta para a tabela intermediária com as comissões específicas
  services ProfessionalService[] @relation("ProfessionalToService")

  // Outras Relações
  clients       Client[]
  businessHours BusinessHour[]
  blockedDates  BlockedDate[]
  blockedSlots  BlockedSlot[]

  appointments      Appointment[] @relation("ProfessionalAppointments")
  ownedAppointments Appointment[] @relation("AccountAppointments")

  trialWarningSentAt   DateTime? // Carimbo de quando enviou o aviso de 2 dias
  trialExpiredSentAt   DateTime? // Carimbo de quando enviou o aviso de expirado

  // Última vez que algo aconteceu no produto para este tenant (agendamento
  // criado, próprio ou de cliente). Base do estado RESFRIANDO (>72h parado).
  lastProductEventAt DateTime?

  // Marco de ativação (S3): primeira vez que uma CLIENTE real marcou —
  // definitivo, não desfaz se aquele agendamento for cancelado depois.
  activatedAt DateTime?
  // Controla o envio do T4 (o toque mais importante da régua) — evita
  // reenvio e segura o disparo fora da janela 9h-20h.
  t4SentAt    DateTime?

  trialTouches TrialTouch[]

  // Opt-in explícito pra Syncro mandar mensagem no WhatsApp dela durante o
  // trial — sem isso marcado, NENHUM toque da régua sai (o telefone
  // obrigatório não basta). Ver REGUA_RELACIONAMENTO_WHATSAPP.md §12.
  whatsappOptin       Boolean   @default(false)
  whatsappOptinAt     DateTime?
  whatsappOptinOrigem String? // "cadastro_web" | "anuncio_ctwa" | "resposta_dm"
  whatsappOptinTexto  String?   @db.Text // texto exato exibido no checkbox — vem do front, nunca reconstruído aqui
  whatsappOptinIp     String?

  // Saída da régua (resposta negativa clara, ou clique no link de opt-out
  // das mensagens de Marketing). Independente do whatsappOptin — uma vez
  // opt-out, não volta sozinho.
  optOut   Boolean   @default(false)
  optOutAt DateTime?

  // Fim do fluxo de onboarding guiado (/onboarding): existe link público e ele
  // funciona. NÃO é o mesmo que `activatedAt` (primeira CLIENTE real marcou) —
  // aquele é marco da régua e alimenta o T4; este só diz que ela terminou a
  // configuração mínima. Marcado ao renderizar o passo "seu link está pronto".
  onboardingCompletedAt DateTime?

  onboardingEvents OnboardingEvent[]
}

// Log de disparo dos toques por calendário/estado da régua de trial (T1, T3,
// T6, T8, T10, T13, T14...). Uma linha por toque efetivamente enviado — a
// unicidade (userId, touch) é a garantia de que nunca reenvia.
model TrialTouch {
  id         String            @id @default(cuid())
  userId     String
  touch      String // "T1" | "T3" | "T6" | "T8" | "T10" | "T13" | "T14" | ...
  sentAt     DateTime          @default(now())
  status     TrialTouchStatus  @default(PENDENTE)
  tentativas Int               @default(0)
  erro       String?           @db.Text // mensagem do último erro de envio, quando status = FALHOU

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, touch])
  @@index([userId])
}

model Service {
  id            String                @id @default(cuid())
  userId        String // ID do dono da conta (Admin) que criou o serviço
  name          String
  icon          String                @default("scissors")
  duration      Int
  priceCents    Int
  imageUrl      String?
  user          User                  @relation("UserOwnedServices", fields: [userId], references: [id])
  professionals ProfessionalService[] @relation("ServiceToProfessional")

  appointments AppointmentService[]

  hasMaintenance             Boolean @default(false)
  maintenancePriceCents      Int? // Preço opcional para manutenção
  maintenanceDurationMinutes Int? // Duração opcional para manutenção

  optimizeSlots              Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
}

// 👇 NOVO MODELO: Tabela intermediária para definir a comissão de cada profissional por serviço
model ProfessionalService {
  professionalId String
  serviceId      String

  // Regras específicas para esta combinação (Profissional x Serviço)
  commissionRate Float? // Se nulo, o sistema vai usar o 'defaultCommissionRate' do User
  commissionType String? // "PERCENTAGE" ou "FIXED". Se nulo, usa o tipo padrão do User

  professional User    @relation("ProfessionalToService", fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service @relation("ServiceToProfessional", fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId]) // Garante que não haja duplicatas do mesmo serviço para o mesmo profissional
  @@index([professionalId])
  @@index([serviceId])
}

model Appointment {
  id             String            @id @default(uuid())
  date           DateTime
  status         AppointmentStatus
  notes          String?
  professionalId String
  professional   User              @relation("ProfessionalAppointments", fields: [professionalId], references: [id])

  userId String
  user   User   @relation("AccountAppointments", fields: [userId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  publicCancelToken          String?   @unique
  publicCancelTokenExpiresAt DateTime?
  dayReminderSentAt          DateTime?
  dayReminderProcessingAt    DateTime?
  hourReminderSentAt         DateTime?
  hourReminderProcessingAt   DateTime?
  createdAt                  DateTime  @default(now())

  // Dados de Pagamento e PIX
  paymentStatus String  @default("NOT_REQUIRED")
  transactionId String? @unique
  depositCents  Int?
  pixPayload    String? @db.Text

  // Dados Financeiros do Agendamento
  commissionValueCents Int?
  pixFeeCents          Int?
  netRevenueCents      Int?

  // 🌟 A LINHA QUE FALTAVA ADICIONAR ESTÁ AQUI:
  services AppointmentService[]

  @@map("appointments")

  isVIP Boolean @default(false)

  // Default PROFISSIONAL: falha fechado. Um agendamento sem origem
  // explícita nunca deve contar como ativação (S3) por engano.
  origem BookingOrigem @default(PROFISSIONAL)
}

model BlockedDate {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model BlockedSlot {
  id        String   @id @default(uuid())
  userId    String
  start     DateTime
  end       DateTime
  reason    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([start])
  @@index([end])
}

model BusinessHour {
  id        String   @id @default(uuid())
  userId    String
  weekday   Int
  start     String
  end       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, weekday, start, end])
}

model Client {
  id        String   @id @default(uuid())
  userId    String
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id])
  appointments Appointment[]

  @@unique([userId, phone])
  @@index([userId])
}

model AppointmentService {
  id String @id @default(uuid())

  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  isMaintenance Boolean @default(false)
  priceCents    Int // Salva o valor pago na hora (Normal ou Manutenção)
  duration      Int // Salva o tempo do serviço na hora

  @@map("appointment_services")
}

// Idempotência de webhooks: garante que o mesmo evento (ex: reenvio do Asaas
// após timeout) nunca é processado (nem notificado ao RD Station) duas vezes.
model ProcessedWebhookEvent {
  id          String             @id @default(cuid())
  eventKey    String             @unique // ex: "asaas:PAYMENT_CONFIRMED:pay_xxx"
  processedAt DateTime           @default(now()) // criação da linha (reserva)
  status      WebhookEventStatus @default(PENDENTE)
  tentativas  Int                @default(0) // nº de processamentos que FALHARAM
  erro        String?            @db.Text // mensagem do último erro, quando status = FALHOU
}

// Telemetria do funil de onboarding guiado (/onboarding). Uma linha por
// transição de passo — responde "em que passo a pessoa parou?" sem palpite.
// Aditivo, nunca destrutivo. Não alimenta nenhuma regra de negócio.
model OnboardingEvent {
  id        String   @id @default(cuid())
  userId    String
  step      Int // 1..5
  action    String // 'entrou' | 'concluiu' | 'pulou'
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, step])
}
